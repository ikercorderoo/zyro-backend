generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = "postgresql://postgres:WaWdQMEdvxWxtBqkZTKkFqpwJGBEjwAk@shortline.proxy.rlwy.net:26908/railway"
}

model User {
  id                String         @id @default(uuid())
  name              String
  lastName          String?
  email             String         @unique
  phone             String?
  password          String
  role              Role           @default(CLIENT)
  specialty         String?
  createdAt         DateTime       @default(now())
  isVerified        Boolean        @default(false)
  verificationToken String?
  bookings          Booking[]      @relation("UserBookings")
  businesses        Business[]
  notifications     Notification[]
}

model Business {
  id                 String            @id @default(uuid())
  name               String
  ownerId            String
  minLeadTime        Int               @default(0)
  maxBookingWindow   Int               @default(365)
  cancellationWindow Int               @default(0)
  bufferTime         Int               @default(0)
  slotInterval       Int               @default(30)
  address            String?
  latitude           Float?
  longitude          Float?
  slug               String            @unique @default("")
  description        String?
  categoryId         String?
  imageUrl           String?
  bannerUrl          String?
  createdAt          DateTime          @default(now())
  category           BusinessCategory? @relation(fields: [categoryId], references: [id])
  owner              User              @relation(fields: [ownerId], references: [id])
  gallery            GalleryImage[]
  services           Service[]
  staff              Staff[]
}

model Staff {
  id         String         @id @default(uuid())
  businessId String
  name       String
  role       String?
  imageUrl   String?
  createdAt  DateTime       @default(now())
  blocks     Block[]
  bookings   Booking[]
  gallery    GalleryImage[]
  schedules  Schedule[]
  business   Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model Block {
  id        String   @id @default(uuid())
  staffId   String
  startTime DateTime
  endTime   DateTime
  reason    String?
  createdAt DateTime @default(now())
  staff     Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
}

model Schedule {
  id          String  @id @default(uuid())
  staffId     String
  dayOfWeek   String
  startTime   String
  endTime     String
  isAvailable Boolean @default(true)
  staff       Staff   @relation(fields: [staffId], references: [id], onDelete: Cascade)
}

model Service {
  id              String           @id @default(uuid())
  businessId      String
  name            String
  description     String?
  duration        Int
  price           Decimal          @db.Decimal(10, 2)
  active          Boolean          @default(true)
  createdAt       DateTime         @default(now())
  bookingServices BookingService[]
  business        Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  addons          ServiceAddon[]
}

model Booking {
  id                 String           @id @default(uuid())
  userId             String
  staffId            String
  startTime          DateTime
  endTime            DateTime
  status             BookingStatus    @default(CONFIRMED)
  notes              String?
  cancellationReason String?
  createdAt          DateTime         @default(now())
  staff              Staff            @relation(fields: [staffId], references: [id])
  user               User             @relation("UserBookings", fields: [userId], references: [id])
  addons             BookingAddon[]
  services           BookingService[]
  feedback           Feedback?
}

model BookingService {
  id        String  @id @default(uuid())
  bookingId String
  serviceId String
  price     Decimal @db.Decimal(10, 2)
  duration  Int
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  service   Service @relation(fields: [serviceId], references: [id])
}

model Feedback {
  id        String   @id @default(uuid())
  bookingId String   @unique
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model GalleryImage {
  id         String   @id @default(uuid())
  businessId String
  staffId    String?
  url        String
  caption    String?
  createdAt  DateTime @default(now())
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  staff      Staff?   @relation(fields: [staffId], references: [id])
}

model BusinessCategory {
  id         String     @id @default(uuid())
  name       String     @unique
  slug       String     @unique
  icon       String?
  businesses Business[]
}

model Notification {
  id       String   @id @default(uuid())
  userId   String
  userType String
  message  String
  read     Boolean  @default(false)
  sentAt   DateTime @default(now())
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ServiceAddon {
  id            String         @id @default(uuid())
  serviceId     String
  name          String
  price         Decimal        @db.Decimal(10, 2)
  duration      Int
  active        Boolean        @default(true)
  createdAt     DateTime       @default(now())
  bookingAddons BookingAddon[]
  service       Service        @relation(fields: [serviceId], references: [id], onDelete: Cascade)
}

model BookingAddon {
  id             String       @id @default(uuid())
  bookingId      String
  serviceAddonId String
  price          Decimal      @db.Decimal(10, 2)
  duration       Int
  booking        Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  serviceAddon   ServiceAddon @relation(fields: [serviceAddonId], references: [id])
}

enum Role {
  CLIENT
  PROFESSIONAL
  ADMIN
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}
